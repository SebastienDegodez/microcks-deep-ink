{
  "$comment": "RGAA 4.1.2 criteria map. Edit this file to change automation coverage. automatedBy is the primary engine: a11ylint, axe or manual. Titles are short English paraphrases: verify numbers and wording against https://accessibilite.numerique.gouv.fr/ before publishing anything.",
  "rgaaVersion": "4.1.2",
  "engines": {
    "a11ylint": "@a11ylint/core@1.0.0-alpha.7",
    "axe": "axe-core@4.14.0"
  },
  "pageLevelOnlyForStories": [
    "8.1",
    "8.3",
    "8.5",
    "9.1",
    "12.6",
    "12.7"
  ],
  "a11ylintRules": {
    "1.1.1": {
      "criterion": "1.1",
      "applicableWhen": "img",
      "hint": "Give the <img> a non-empty alt (or aria-label / aria-labelledby). Use alt=\"\" only for decorative images."
    },
    "1.1.2": {
      "criterion": "1.1",
      "applicableWhen": "area",
      "hint": "Give the <area> an alt or aria-label."
    },
    "1.1.5": {
      "criterion": "1.1",
      "applicableWhen": "svgImg",
      "hint": "Give <svg role=\"img\"> an aria-label or aria-labelledby, or hide decorative SVG with aria-hidden=\"true\"."
    },
    "2.1.1": {
      "criterion": "2.1",
      "applicableWhen": "frame",
      "hint": "Add a title attribute to the frame."
    },
    "2.2.1": {
      "criterion": "2.2",
      "applicableWhen": "frame",
      "hint": "Use a descriptive frame title (not \"frame\"/\"iframe\", not empty)."
    },
    "3.2.1": {
      "criterion": "3.2",
      "applicableWhen": "text",
      "hint": "Text under 24px and not bold needs a 4.5:1 contrast ratio. Use the design-system tokens."
    },
    "3.2.2": {
      "criterion": "3.2",
      "applicableWhen": "text",
      "hint": "Bold text under 18.5px needs a 4.5:1 contrast ratio."
    },
    "3.2.3": {
      "criterion": "3.2",
      "applicableWhen": "text",
      "hint": "Large text needs a 3:1 contrast ratio."
    },
    "3.2.4": {
      "criterion": "3.2",
      "applicableWhen": "text",
      "hint": "Large bold text needs a 3:1 contrast ratio."
    },
    "6.2.1": {
      "criterion": "6.2",
      "applicableWhen": "link",
      "hint": "Give the link visible text, aria-label, aria-labelledby or a title."
    },
    "8.1.1": {
      "criterion": "8.1",
      "applicableWhen": "always",
      "hint": "Start the document with <!doctype html>."
    },
    "8.1.3": {
      "criterion": "8.1",
      "applicableWhen": "always",
      "hint": "The doctype must be the first node of the document."
    },
    "8.3": {
      "criterion": "8.3",
      "applicableWhen": "always",
      "hint": "Add a lang attribute to <html>."
    },
    "8.5": {
      "criterion": "8.5",
      "applicableWhen": "always",
      "hint": "Add a non-empty <title>."
    },
    "9.1.1": {
      "criterion": "9.1",
      "applicableWhen": "headings2",
      "hint": "Do not skip heading levels going down the outline."
    },
    "9.1.3": {
      "criterion": "9.1",
      "applicableWhen": "headings",
      "hint": "Use <h1>-<h6>, or role=\"heading\" with aria-level."
    },
    "11.1.1": {
      "criterion": "11.1",
      "applicableWhen": "field",
      "hint": "Give the field a visible <label for>, a wrapping <label>, aria-label or aria-labelledby."
    },
    "11.1.2": {
      "criterion": "11.1",
      "applicableWhen": "field",
      "hint": "Each label[for] must point to an existing field id."
    }
  },
