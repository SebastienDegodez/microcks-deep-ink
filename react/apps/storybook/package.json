{
  "name": "storybook-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen:exports": "node scripts/gen-exports.mjs",
    "storybook": "node scripts/gen-exports.mjs && storybook dev -p 6006",
    "build-storybook": "node scripts/gen-exports.mjs && storybook build -o storybook-static",
    "typecheck": "node scripts/gen-exports.mjs && tsc --noEmit",
    "test:stories": "node scripts/gen-exports.mjs && vitest --project storybook run"
  },
  "dependencies": {
    "@microcks/deep-ink": "workspace:*",
    "@microcks-deep-ink/plugin-sdk": "link:../../../packages/plugin-sdk",
    "@microcks-deep-ink/registry": "link:../../../packages/registry",
    "@microcks-deep-ink/storybook-shared": "link:../../../apps/shared",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-mcp": "^10.6.6",
    "@storybook/addon-vitest": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "playwright": "^1.65.0",
    "storybook": "^10.6.6",
    "typescript": "~6.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
