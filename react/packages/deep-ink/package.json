{
  "name": "@microcks/deep-ink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Deep Ink React components for the Microcks UI v2. Not published: private until the maintainers decide.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workflow-loom": {
      "types": "./dist/workflow-loom.d.ts",
      "default": "./dist/workflow-loom.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.no-fonts.css": "./dist/styles.no-fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css",
    "./dist/elements/*.js",
    "./src/elements/*.js"
  ],
  "scripts": {
    "build": "node scripts/sync-elements.mjs && node scripts/gen-index.mjs --check && rm -rf dist && vite build && tsc -p tsconfig.build.json && node scripts/finish-types.mjs && node scripts/build-css.mjs",
    "gen:index": "node scripts/gen-index.mjs",
    "test": "vitest run --maxWorkers=2",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "publint": "publint",
    "attw": "attw --pack . --profile esm-only --exclude-entrypoints styles.css styles.no-fonts.css",
    "pack:check": "pnpm pack --dry-run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@microcks-deep-ink/core": "link:../../../packages/core",
    "@microcks-deep-ink/registry": "link:../../../packages/registry",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "4.14.0",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.0",
    "jsdom": "^30.1.0",
    "publint": "^0.3.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
