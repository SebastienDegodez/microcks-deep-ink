{
  "name": "@microcks/deep-ink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Deep Ink Svelte 5 components for the Microcks UI v2. Private, not published (React owns the npm name for now).",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.no-fonts.css": "./dist/styles.no-fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/*.test.*"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/gen-index.mjs --check && rm -rf dist && svelte-package -i src/lib -o dist && node scripts/build-css.mjs",
    "gen:index": "node scripts/gen-index.mjs",
    "pending": "node scripts/gen-index.mjs --pending",
    "test": "vitest run --maxWorkers=2",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint src test scripts",
    "publint": "publint"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@microcks-deep-ink/registry": "link:../../../packages/registry",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "axe-core": "4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.24.0",
    "jsdom": "^30.1.3",
    "publint": "^0.3.25",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
