{
  "name": "@microcks/deep-ink",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Native Svelte 5 presentational components and shared layered Deep Ink CSS. Private, not published.",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.no-fonts.css": "./dist/styles.no-fonts.css",
    "./package.json": "./package.json"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "svelte-package -i src/lib -o dist && node scripts/build-css.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "pnpm build && vitest run && vitest run --config vite.ssr.config.ts",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "svelte": "^5.19.0"
  },
  "devDependencies": {
    "@microcks-deep-ink/registry": "link:../../../packages/registry",
    "@sveltejs/package": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^22.0.0",
    "axe-core": "^4.11.0",
    "jsdom": "^27.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
