{
  "name": "deep-ink-svelte-workspace",
  "private": true,
  "description": "Isolated native Svelte 5 workspace of Deep Ink; consumes the root's built shared CSS.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @microcks/deep-ink build",
    "check": "pnpm -r --if-present check",
    "test": "pnpm --filter @microcks/deep-ink test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "storybook": "pnpm --filter storybook-svelte storybook",
    "build:storybook": "pnpm --filter storybook-svelte build-storybook",
    "smoke:package": "node scripts/smoke-package.mjs"
  }
}
