{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": [],
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "paths": {
      "@microcks/deep-ink": [
        "../../../react/packages/deep-ink/src/index.ts"
      ],
      "react": [
        "../node_modules/@types/react"
      ],
      "react/*": [
        "../node_modules/@types/react/*"
      ]
    }
  },
  "exclude": [
    "../src/test.ts",
    "../src/**/*.spec.ts"
  ],
  "include": [
    "../src/**/*.stories.*",
    "../src/**/_meta.ts",
    "./preview.ts",
    "./theme.ts",
    "../../shared/*.ts",
    "../../shared/copy-panel/a11y-doc.ts",
    "../../../packages/registry/src/angular/**/*.ts"
  ],
  "files": [
    "./typings.d.ts"
  ]
}
