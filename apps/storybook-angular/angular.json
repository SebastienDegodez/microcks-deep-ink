{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "pnpm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "storybook-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "storybook-angular:build",
            "compodoc": false,
            "port": 6007,
            "styles": [
              "node_modules/@microcks-deep-ink/tokens/dist/deep-ink.css",
              "node_modules/@microcks-deep-ink/registry/dist/deep-ink-components.css",
              "node_modules/@microcks-deep-ink/storybook-shared/foundations.css"
            ]
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "storybook-angular:build",
            "compodoc": false,
            "outputDir": "storybook-static",
            "styles": [
              "node_modules/@microcks-deep-ink/tokens/dist/deep-ink.css",
              "node_modules/@microcks-deep-ink/registry/dist/deep-ink-components.css",
              "node_modules/@microcks-deep-ink/storybook-shared/foundations.css"
            ]
          }
        },
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist",
            "index": "",
            "main": "",
            "tsConfig": ".storybook/tsconfig.json",
            "polyfills": [
              "zone.js"
            ]
          }
        }
      }
    }
  }
}
