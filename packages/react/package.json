{
  "name": "@microcks-deep-ink/react",
  "version": "0.1.0",
  "description": "React 18/19 wrappers for the Microcks Deep Ink Web Components, generated by the Stencil React output target.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@microcks-deep-ink/core": "workspace:*",
    "@microcks-deep-ink/plugin-sdk": "workspace:*",
    "@stencil/react-output-target": "^1.7.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~6.0.0"
  }
}
