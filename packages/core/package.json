{
  "name": "@microcks-deep-ink/core",
  "private": true,
  "version": "0.1.0",
  "description": "Microcks Deep Ink Web Components (Stencil). Framework-agnostic source of truth for the React and Angular wrappers.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    },
    "./dist/components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./dist/*": "./dist/*",
    "./deep-ink.css": "./dist/deep-ink/deep-ink.css",
    "./dist/elements/*": "./dist/elements/*"
  },
  "files": [
    "dist",
    "loader"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "stencil build && node scripts/bundle-elements.mjs",
    "start": "stencil build --dev --watch --serve",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@microcks-deep-ink/plugin-sdk": "workspace:*",
    "@microcks-deep-ink/tokens": "workspace:*",
    "@stencil/core": "^4.45.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "vitest": "^5.1.0"
  }
}
