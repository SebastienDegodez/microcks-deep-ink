{
  "name": "@microcks-deep-ink/plugin-sdk",
  "private": true,
  "version": "0.1.0",
  "description": "Contract between the Microcks UI v2 shell and marketplace plugins: manifest types, extension points and the shared plugin host.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./microcks-plugin.schema.json": "./microcks-plugin.schema.json"
  },
  "files": [
    "dist",
    "microcks-plugin.schema.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "~6.0.0"
  }
}
