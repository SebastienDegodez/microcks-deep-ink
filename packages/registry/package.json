{
  "name": "@microcks-deep-ink/registry",
  "private": true,
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Single source of truth for copyable Deep Ink components (React, Angular, CSS, HTML recipes). Read by the CLI and the Storybook Copy panel.",
  "exports": {
    "./react/*": "./src/react/*.tsx",
    "./angular/*": "./src/angular/*.ts",
    "./css/*": "./src/css/*",
    "./html/*": "./src/html/*",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.react.json && ngc -p tsconfig.angular.json",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@microcks-deep-ink/core": "workspace:*",
    "@microcks-deep-ink/tokens": "workspace:*",
    "ajv": "^8.20.0",
    "typescript": "~6.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@angular/core": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.8.0",
    "vitest": "^5.1.0",
    "jsdom": "^30.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/dom": "^10.4.0",
    "axe-core": "4.14.0",
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.72.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.6.0",
    "@angular-eslint/template-parser": "^22.6.0"
  }
}
