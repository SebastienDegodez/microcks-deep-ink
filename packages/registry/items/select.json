{
  "$schema": "../registry.schema.json",
  "name": "select",
  "title": "Select",
  "tier": "natural",
  "description": "Native select with a custom caret and a 3:1 border.",
  "registryDependencies": ["base"],
  "npmDependencies": { "react": [], "angular": [] },
  "a11y": {
    "pattern": "Native <select>",
    "keyboard": [
      ["Space / Alt+↓", "Opens the list"],
      ["↑ / ↓", "Changes the selected option"],
      ["Type a letter", "Jumps to a matching option"],
      ["Escape", "Closes the list"]
    ],
    "aria": ["Label with Field or <label for>", "aria-invalid=\"true\" when the value is wrong", "Group options with <optgroup label>"],
    "rgaa": ["3.3", "11.1", "11.6", "11.10"],
    "wcag": ["1.3.1", "1.4.11", "3.3.2", "4.1.2"],
    "notes": "Keep the native element: it brings the platform picker on mobile and full keyboard support."
  },
  "stories": ["Components/Select"]
}
